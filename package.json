{
  "name": "bioaccess",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit \u0026\u0026 vite build",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "migrate": "node --env-file-if-exists=.env --import tsx server/setup.ts migrate",
    "seed": "node --env-file-if-exists=.env --import tsx server/setup.ts seed",
    "test": "tsx --test server/*.test.ts",
    "evaluate": "node --env-file-if-exists=.env --import tsx server/evaluate-cli.ts",
    "demo": "node --env-file-if-exists=.env --import tsx server/demo.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write server web *.json *.ts *.yaml docs README.md"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
